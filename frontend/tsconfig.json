{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "App.tsx",
    "main.tsx",
    "vite.config.ts",
    "localApi.ts",
    "nodeRuntime.ts",
    "backendGlobals.d.ts",
    "server.ts",
    "pages",
    "components",
    "utils",
    "lib",
    "hooks"
  ]
}
