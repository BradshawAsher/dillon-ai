    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  // Access the original Webhook node data\n  const webhookData = $('Webhook').all()[index].json.body;\n  \n  // // Access the Google Drive node data\n  // Note: Ensure this matches the exact name of your Google Drive node in the editor\n  const driveData = $('Upload file').all()[index].json;\n\n  // 1. Helpers\n  const cleanName = (val) => val ? val.toUpperCase().trim() : \"N/A\";\n  const cleanEmail = (val) => val ? val.trim() : \"N/A\";\n  const cleanNotes = (val) => val ? val.trim() : \"N/A\"; \n  const cleanString = (val) => val ? val.trim() : \"N/A\"; \n  const cleanWorkstream = (val) => val ? \n              val.charAt(0).toUpperCase() + val.slice(1).toLowerCase() : \n              \"General\";\n\n  // 2. Map data\n  return {\n    json: {\n      requestID: webhookData.requestID,\n      fileName: webhookData.fileName,\n      fileSize: webhookData.fileSize,\n      fileType: webhookData.fileType,\n      triggerTimestamp: webhookData.triggerTimestamp,\n\n      //project specific\n      projectId: webhookData.projectId,\n      projectStage: webhookData.projectStage,\n      documentType: webhookData.documentType,\n      \n      // New field from Google Drive node\n      driveFileID: driveData.id, \n      \n      dealName: cleanName(webhookData.dealName),\n      companyName: cleanString(webhookData.companyName),\n      analystName: cleanString(webhookData.analystName),\n      analystEmail: cleanEmail(webhookData.analystEmail),\n      submissionNotes: cleanNotes(webhookData.submissionNotes),\n      workstream: cleanWorkstream(webhookData.workstream),\n      \n      status: 'queued',\n      receivedAt: new Date().toISOString()\n    }\n  };\n});"
      },
