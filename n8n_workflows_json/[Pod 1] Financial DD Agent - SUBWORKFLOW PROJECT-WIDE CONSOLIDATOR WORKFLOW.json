    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": { \"type\": \"string\", \"const\": \"Project-level due diligence synthesis\" },\n    \"global_confidence\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1 },\n    \"traffic_light\": { \"type\": \"string\", \"enum\": [\"GREEN\", \"YELLOW\", \"RED\"] },\n    \"valuation\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"lower_bound\": { \"type\": \"number\" },\n        \"base_estimate\": { \"type\": \"number\" },\n        \"upper_bound\": { \"type\": \"number\" },\n        \"confidence_score\": { \"type\": \"number\" },\n        \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n      },\n      \"required\": [\"lower_bound\", \"base_estimate\", \"upper_bound\", \"confidence_score\"]\n    },\n    \"investment_thesis\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"is_favorable_indicator\": { \"type\": \"boolean\" },\n        \"buy_reasoning\": { \"type\": \"string\" },\n        \"confidence_score\": { \"type\": \"number\" },\n        \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n      },\n      \"required\": [\"is_favorable_indicator\", \"buy_reasoning\", \"confidence_score\"]\n    },\n    \"response\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"summary\": { \"type\": \"string\" },\n        \"flags\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"red_flags\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"description\": { \"type\": \"string\" },\n                  \"confidence_score\": { \"type\": \"number\" },\n                  \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n                },\n                \"required\": [\"description\", \"confidence_score\", \"citations\"]\n              }\n            },\n            \"yellow_flags\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"description\": { \"type\": \"string\" },\n                  \"confidence_score\": { \"type\": \"number\" },\n                  \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n                },\n                \"required\": [\"description\", \"confidence_score\", \"citations\"]\n              }\n            },\n            \"green_flags\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"description\": { \"type\": \"string\" },\n                  \"confidence_score\": { \"type\": \"number\" },\n                  \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n                },\n                \"required\": [\"description\", \"confidence_score\", \"citations\"]\n              }\n            }\n          }\n        }\n      },\n      \"required\": [\"summary\", \"flags\"]\n    },\n    \"reconciliation_findings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"topic\": { \"type\": \"string\" },\n          \"severity\": { \"type\": \"string\", \"enum\": [\"LOW\", \"MEDIUM\", \"HIGH\"] },\n          \"description\": { \"type\": \"string\" },\n          \"confidence_score\": { \"type\": \"number\" },\n          \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n          \"documents_conflicting\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        },\n        \"required\": [\"topic\", \"severity\", \"description\", \"confidence_score\"]\n      }\n    },\n    \"open_questions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"question\": { \"type\": \"string\" },\n          \"priority\": { \"type\": \"string\", \"enum\": [\"LOW\", \"MEDIUM\", \"HIGH\"] },\n          \"reasoning\": { \"type\": \"string\" },\n          \"confidence_score\": { \"type\": \"number\" },\n          \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        },\n        \"required\": [\"question\", \"priority\", \"confidence_score\"]\n      }\n    },\n    \"negotiation_levers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"theme\": { \"type\": \"string\" },\n          \"impact\": { \"type\": \"string\", \"enum\": [\"VALUATION\", \"STRUCTURE\", \"TERMS\"] },\n          \"suggestion\": { \"type\": \"string\" },\n          \"confidence_score\": { \"type\": \"number\" },\n          \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n        },\n        \"required\": [\"theme\", \"impact\", \"suggestion\", \"confidence_score\"]\n      }\n    },\n    \"final_recommendation\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"recommendation\": { \"type\": \"string\", \"enum\": [\"PROCEED\", \"PROCEED_WITH_CAUTION\", \"RENEGOTIATE\", \"ESCALATE\", \"WALK_AWAY\"] },\n        \"citations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"confidence_score\": { \"type\": \"number\" }\n      },\n      \"required\": [\"recommendation\", \"confidence_score\"]\n    }\n  },\n  \"required\": [\n    \"intent\",\n    \"global_confidence\",\n    \"traffic_light\",\n    \"valuation\",\n    \"investment_thesis\",\n    \"response\",\n    \"reconciliation_findings\",\n    \"open_questions\",\n    \"negotiation_levers\",\n    \"final_recommendation\"\n  ]\n}",
        "autoFix": true,
        "customizeRetryPrompt": true,
        "prompt": "You are an automated data validator. You are currently in an error-recovery state. Your previous output was rejected. You must now produce a perfectly valid JSON output that corrects the previous structural violation\n\nCRITICAL SCHEMA VALIDATION ERROR\n--------------------------------\nThe previous output failed to satisfy the structural constraints required by the Financial Due Diligence Agent. \n\nError Details: \n{error}\n\nInstructions & Schema:\n{instructions}\n\nCorrection Required:\n1. Review the Schema definition above. \n2. Ensure {field_name} is strictly provided as a {required_type} (e.g., ensure target_value is a number, not a string).\n3. Do not include any conversational text, explanations, or markdown formatting outside the JSON block.\n4. If the data is missing or cannot be reconciled, set \"is_escalated\" to true and provide the appropriate \"reason_code\".\n\nOutput valid JSON only. Begin your response immediately with an opening brace '{'.\n\nCOMPLETION:\n{completion}"
      },
